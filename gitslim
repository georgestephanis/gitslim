#!/usr/bin/env bash
# gitslim — interactively find and slim git repositories to shallow clones
#
# Requires: bash 3.0+, git, find, du, tput, sort
# Usage: gitslim [search-root]   (default: $HOME)
#
# Keys: ↑/↓ or j/k navigate · SPACE mark · S slim marked · R age · Z size · P path · Q quit

set -uo pipefail

if (( BASH_VERSINFO[0] < 3 )); then
    printf 'gitslim: requires bash 3.0 or newer (running %s)\n' "$BASH_VERSION" >&2
    exit 1
fi

# Keys are read from stdin; without a terminal there read_key can't block.
# Checked before the EXIT trap so a refusal doesn't emit terminal sequences.
if [[ ! -t 0 ]]; then
    printf 'gitslim: stdin must be a terminal\n' >&2
    exit 1
fi

SEARCH_ROOT="${1:-$HOME}"
# No trailing slash: find would print "root//sub", which defeats -path excludes
while [[ "$SEARCH_ROOT" == ?*/ ]]; do SEARCH_ROOT="${SEARCH_ROOT%/}"; done

# ── Debug log ──────────────────────────────────────────────────────────────────
# Set GITSLIM_DEBUG_LOG to a path (e.g. /tmp/gitslim-debug.log) to enable.
DEBUG_LOG="${GITSLIM_DEBUG_LOG:-}"
_log() {
    [[ -z "$DEBUG_LOG" ]] && return
    { printf '%s %s\n' "$(date '+%T')" "$*" >> "$DEBUG_LOG"; } 2>/dev/null
}
# An unwritable path would spray shell errors over the TUI; warn once, before
# the TUI starts, and run without logging.
if [[ -n "$DEBUG_LOG" ]] && ! { : > "$DEBUG_LOG"; } 2>/dev/null; then
    printf 'gitslim: cannot write debug log %s; logging disabled\n' "$DEBUG_LOG" >&2
    DEBUG_LOG=""
fi

# ── Brand palette (ANSI 256-colour) ───────────────────────────────────────────
ESC=$'\033'
RESET="${ESC}[0m"
BOLD="${ESC}[1m"
REVERSE="${ESC}[7m"
MAGENTA="${ESC}[38;5;199m"   # #ff2bbe  marks, prompts, destructive
CYAN="${ESC}[38;5;51m"        # #36f9f6  cursor, focus, links
AMBER="${ESC}[38;5;221m"      # #ffcf3a  warning (large sizes, skips)
LIME="${ESC}[38;5;155m"       # #b8ff5c  success (bytes freed)
VIOLET="${ESC}[38;5;141m"     # #a06fff  borders, separators
INK="${ESC}[38;5;255m"        # #f0e6ff  primary text
INK_DIM="${ESC}[38;5;103m"    # #9f8fc8  secondary text
INK_MUTE="${ESC}[38;5;60m"    # #5a4d80  key hints

_rows() { local s; s=$(stty size </dev/tty 2>/dev/null) && printf '%s' "${s% *}" || tput lines 2>/dev/null || printf '24'; }
_cols() { local s; s=$(stty size </dev/tty 2>/dev/null) && printf '%s' "${s#* }" || tput cols  2>/dev/null || printf '80'; }
# Non-blocking single-key read; sets REPLY ("" if no key is waiting). bash 3.2's
# `read -t 0` never consumes input, so this relies on the tty being in
# `min 0 time 0` mode (set for the duration of the scan) and reads via dd.
poll_key() { REPLY=$(dd bs=1 count=1 </dev/tty 2>/dev/null); }
_sep()  { printf '%s' "$VIOLET"; printf '─%.0s' $(seq 1 "${1:-$(_cols)}"); printf '%s\n' "$RESET"; }

# ── Data arrays ────────────────────────────────────────────────────────────────
declare -a RP=()   # repo path
declare -a RS=()   # .git size in KB
declare -a RA=()   # age in days since last commit
declare -a RH=()   # has remote: 1/0
declare -a RW=()   # is shallow: true/false
declare -a RU=()   # has unpushed commits: 1/0
declare -a RF=()   # last file modification (epoch seconds; 0 if unknown)
declare -a RM=()   # marked: 1/0
declare -a RI=()   # sorted indices into above arrays

CURSOR=0; SCROLL=0; SORT_BY=age
SCANNING=0       # 1 while scan is running; draw() adapts header/footer
SEARCHING=0      # 1 while `find` runs behind a list seeded from the cache
SAVED_STTY=""    # terminal state saved before TUI entry; restored on cleanup
TOTAL_FREED=0    # cumulative KB freed across slim operations this session
DISCOVER_TMP=""  # discover_repos' find output; removed on cleanup
RESIZED=0        # set by the WINCH trap; drawing loops redraw when they see it

# Cache: ~/.cache/gitslim/cache (XDG); fallback ~/.gitslim-cache
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gitslim"
CACHE_FILE="$CACHE_DIR/cache"
[[ ! -w "${XDG_CACHE_HOME:-$HOME/.cache}" && ! -w "$HOME/.cache" ]] && CACHE_FILE="$HOME/.gitslim-cache"
declare -a CACHE_KEYS=() CACHE_VALS=()   # parallel arrays: key=repo path, val=tab-sep fields

# Config (overridden by load_config)
DEPTH=1    # commits to keep (--depth N)
SINCE=""   # keep history since date/period (overrides DEPTH when set)

# Directories discovery never descends into. A pattern containing "/" is matched
# against the full path (find -path); otherwise against the directory name
# (find -name). Repos in these places are dependencies, caches or tool-managed
# state, and walking ~/Library alone accounts for most of a $HOME scan.
# Extended with `exclude = …` lines in the config file.
EXCLUDES=(
    node_modules
    "$HOME/Library"
    "$HOME/.Trash"
    "$HOME/.cache"
    "$HOME/.npm"
    "$HOME/.cargo"
    "$HOME/.rustup"
    "$HOME/.pyenv"
    "$HOME/.nvm"
    "$HOME/go/pkg"
)

# ── Cleanup ────────────────────────────────────────────────────────────────────
# stty acts on fd 0 by default. A signal can arrive while fd 0 is the `find` pipe
# (inside discover_repos), so every stty call targets /dev/tty explicitly —
# otherwise the restore silently fails and the shell is left without echo.
_cleanup() {
    pkill -P $$ -x find 2>/dev/null || true   # discovery may still be running
    [[ -n "$DISCOVER_TMP" ]] && rm -f "$DISCOVER_TMP"
    tput smam  2>/dev/null || true
    tput rmcup 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    if [[ -n "$SAVED_STTY" ]]; then
        stty "$SAVED_STTY" </dev/tty 2>/dev/null || true
    else
        stty sane </dev/tty 2>/dev/null || true
    fi
}
trap _cleanup EXIT
trap '_log "received SIGINT";  exit 130' INT
trap '_log "received SIGTERM"; exit 143' TERM

# Terminal resized: only set a flag. Drawing from inside the trap isn't
# reliable — on bash 3.2, command substitutions run from a trap that fires
# during a blocking `read` return empty, so _cols/_rows would read as blank.
trap 'RESIZED=1' WINCH

# ── Formatting ─────────────────────────────────────────────────────────────────
fmt_size() {
    local kb=$1 color="${2:-}"
    if [[ -z "$color" ]]; then
        if   (( kb < 102400  )); then color="$INK_DIM"   # < 100 MB
        elif (( kb < 1048576 )); then color="$INK"        # 100 MB – 1 GB
        else                          color="$AMBER"       # ≥ 1 GB
        fi
    fi
    if   (( kb < 1024    )); then
        printf '%s%5dK%s' "$color" "$kb" "$RESET"
    elif (( kb < 1048576 )); then
        printf '%s%5dM%s' "$color" "$((kb / 1024))" "$RESET"
    else
        local gib=$(( kb / 1048576 ))
        local gib_frac=$(( (kb * 10 / 1048576) % 10 ))
        printf '%s%3d.%1dG%s' "$color" "$gib" "$gib_frac" "$RESET"
    fi
}

fmt_age() {
    local d=$1
    if   (( d == 9999 )); then printf -- '-'   # sentinel: no commits / no files / not scanned yet
    elif (( d == 0  )); then printf 'today'
    elif (( d == 1  )); then printf '1 day ago'
    elif (( d <  7  )); then printf '%d days ago'   "$d"
    elif (( d <  14 )); then printf '1 week ago'
    elif (( d <  30 )); then printf '%d weeks ago'  "$((d / 7))"
    elif (( d <  60 )); then printf '1 month ago'
    elif (( d < 365 )); then printf '%d months ago' "$((d / 30))"
    elif (( d < 730 )); then printf '1 year ago'
    else                     printf '%d years ago'  "$((d / 365))"
    fi
}

# Truncate/pad string to exact width (handles ~ paths)
fit() {
    local s="$1" w=$2
    if (( ${#s} > w )); then printf '%s…' "${s:0:$((w - 1))}"
    else printf '%-*s' "$w" "$s"
    fi
}

# ── Sorting ────────────────────────────────────────────────────────────────────
do_sort() {
    local n=${#RP[@]}; RI=()
    (( n == 0 )) && return

    local tmp; tmp=$(mktemp)
    # age/size: descending (oldest/largest first); path: ascending
    for (( i = 0; i < n; i++ )); do
        case "$SORT_BY" in
            age)  printf '%010d\t%d\n' "${RA[$i]}" "$i" ;;
            size) printf '%015d\t%d\n' "${RS[$i]}" "$i" ;;
            path) printf '%s\t%d\n'   "${RP[$i]}" "$i" ;;
        esac
    done | if [[ "$SORT_BY" == path ]]; then sort -t$'\t' -k1
           else sort -t$'\t' -k1 -r
           fi > "$tmp"

    RI=()
    while IFS=$'\t' read -r _ idx; do RI+=("$idx"); done < "$tmp"
    rm -f "$tmp"

    local max=$(( ${#RI[@]} - 1 ))
    (( CURSOR > max )) && CURSOR=$max
    (( CURSOR < 0   )) && CURSOR=0
}

# ── TUI drawing ────────────────────────────────────────────────────────────────
HEADER_H=4   # title + sep + col-headers + sep
# FOOTER_H is computed dynamically in draw() (2 baseline + 1 if legend needed)

draw() {
    local cols rows
    cols=$(_cols); rows=$(_rows)

    local n=${#RI[@]} mc=0 ms=0 has_noremote=0 has_shallow=0 has_unpushed=0 i vi
    for i in "${RI[@]}"; do
        (( RM[i]          )) && { (( mc++ )); (( ms += RS[i] )); }
        (( RH[i] == 0     )) && has_noremote=1
        [[ "${RW[$i]}" == "true" ]] && has_shallow=1
        (( RU[i]          )) && has_unpushed=1
    done

    # Footer is 2 lines (sep + keys) plus 1 if any legend symbols are in use
    local footer_h=2
    (( has_noremote || has_shallow || has_unpushed )) && (( footer_h++ ))

    local vrows=$(( rows - HEADER_H - footer_h ))
    (( vrows < 1 )) && vrows=1

    # Clamp scroll so cursor stays visible
    (( CURSOR < SCROLL          )) && SCROLL=$CURSOR
    (( CURSOR >= SCROLL + vrows )) && SCROLL=$(( CURSOR - vrows + 1 ))
    (( SCROLL < 0               )) && SCROLL=0

    # Row layout: " [M] <path>  <size>  <last commit>  <last touch>  <status> "
    # Fixed visible chars outside path: 1+3+1 + 2+6 + 2+15 + 2+15 + 2+4+1 = 54
    local pw=$(( cols - 54 ))
    (( pw < 12 )) && pw=12

    local now_d; now_d=$(date +%s)

    tput cup 0 0

    # ── Header ──
    local marked_str=""
    (( mc > 0 )) && marked_str="  ${INK_MUTE}·${RESET}  ${MAGENTA}${mc} marked${RESET} ${INK_MUTE}($(fmt_size $ms))${RESET}"
    local freed_str=""
    (( TOTAL_FREED > 0 )) && freed_str="  ${LIME}▲ $(fmt_size $TOTAL_FREED) freed${RESET}"
    if (( SCANNING )); then
        local phase="scanning…"
        (( SEARCHING )) && phase="searching for new repos…"
        printf "${MAGENTA}▍${RESET} ${BOLD}${CYAN}gitslim${RESET}  ${INK_MUTE}%d repos · %s${RESET}%s" "$n" "$phase" "$freed_str"
    else
        printf "${MAGENTA}▍${RESET} ${BOLD}${CYAN}gitslim${RESET}  ${INK_MUTE}%d repos · sort:${RESET}${INK}%s${RESET}%s%s" "$n" "$SORT_BY" "$marked_str" "$freed_str"
    fi
    tput el 2>/dev/null; printf '\n'
    _sep "$cols"

    # ── Column headers ──
    printf "${INK_DIM}     %-*s  %6s  %15s  %15s${RESET}" "$pw" "PATH" ".GIT" "LAST COMMIT" "LAST TOUCH"
    tput el 2>/dev/null; printf '\n'
    _sep "$cols"

    # ── Repo rows ──
    local end=$(( SCROLL + vrows ))
    (( end > n )) && end=$n
    local row=0

    for (( vi = SCROLL; vi < end; vi++ )); do
        local i="${RI[$vi]}"
        local path="${RP[$i]/#$HOME/~}"

        # 4-char status label
        local status
        if   (( RM[i] && RH[i] )) && [[ "${RW[$i]}" != "true" ]] && (( !RU[i] )); then
            status="${LIME}SLIM${RESET}"
        elif [[ "${RW[$i]}" == "true" ]]; then
            status="${INK_MUTE}done${RESET}"
        elif (( !RH[i] )); then
            status="${AMBER}n/rm${RESET}"
        elif (( RU[i] )); then
            status="${MAGENTA}push${RESET}"
        else
            status="    "
        fi

        # Size: magenta when marked (layout-demo: .row.marked .size { color: magenta })
        local size_col
        (( RM[i] )) && size_col="$(fmt_size "${RS[$i]}" "$MAGENTA")" \
                    || size_col="$(fmt_size "${RS[$i]}")"

        # Ages: right-aligned, ink-mute (layout-demo: .num right-align, .age ink-mute)
        local touch_age=9999
        (( RF[i] > 0 )) && touch_age=$(( (now_d - RF[i]) / 86400 ))
        local commit_col touch_col
        commit_col="${INK_MUTE}$(printf '%15s' "$(fmt_age "${RA[$i]}")")${RESET}"
        touch_col="${INK_MUTE}$(printf '%15s' "$(fmt_age "$touch_age")")${RESET}"

        # Cursor row: cyan │ bar + cyan mark and path; normal rows: muted brackets
        local mark path_col
        if (( vi == CURSOR )); then
            printf '%s│%s' "$CYAN" "$RESET"
            (( RM[i] )) && mark="${CYAN}[${MAGENTA}*${CYAN}]${RESET}" \
                        || mark="${CYAN}[ ]${RESET}"
            path_col="${CYAN}$(fit "$path" "$pw")${RESET}"
        else
            printf ' '
            (( RM[i] )) && mark="[${MAGENTA}*${RESET}]" \
                        || mark="${INK_MUTE}[ ]${RESET}"
            path_col="$(fit "$path" "$pw")"
        fi

        printf "%s ${path_col}  %s  %s  %s  %s " \
            "$mark" \
            "$size_col" \
            "$commit_col" \
            "$touch_col" \
            "$status"
        tput el 2>/dev/null
        printf '\n'
        (( row++ ))
    done

    # Fill blank rows so stale content doesn't show
    for (( ; row < vrows; row++ )); do
        tput el 2>/dev/null; printf '\n'
    done

    # ── Footer ──
    _sep "$cols"
    if (( SCANNING )); then
        printf " ${INK_MUTE}scanning — ${CYAN}Q${INK_MUTE} to quit${RESET}"
    else
        printf " ${CYAN}↑↓/jk${INK_MUTE} move  ${CYAN}SPC${INK_MUTE} mark  ${MAGENTA}S${INK_MUTE} slim  ${CYAN}R${INK_MUTE} age  ${CYAN}Z${INK_MUTE} size  ${CYAN}P${INK_MUTE} path  ${INK_MUTE}Q quit${RESET}"
    fi
    tput el 2>/dev/null
    if (( footer_h == 3 )); then
        printf '\n'
        local legend=""
        (( has_shallow  )) && legend+=" ${INK_MUTE}done${RESET}${INK_MUTE}=already shallow${RESET}"
        (( has_noremote )) && legend+="${INK_MUTE}  ${AMBER}n/rm${RESET}${INK_MUTE}=no remote${RESET}"
        (( has_unpushed )) && legend+="${INK_MUTE}  ${MAGENTA}push${RESET}${INK_MUTE}=push first${RESET}"
        printf "%s" "$legend"
        tput el 2>/dev/null
    fi
    # No trailing newline — printing past the last row scrolls the terminal
}

# ── Key input ──────────────────────────────────────────────────────────────────
read_key() {
    local _c
    # Wake every second so a resize redraws without waiting for a key. A
    # timeout loses nothing: -n1 completes on the first byte that arrives.
    # bash 3.2 returns the same status for a timeout and EOF, so treat stdin
    # that is no longer a terminal as quit rather than spinning on EOF.
    until IFS= read -r -s -n1 -t 1 REPLY; do
        (( RESIZED )) && { REPLY=""; return; }
        [[ -t 0 ]] || { REPLY=q; return; }
    done
    if [[ $REPLY == $'\033' ]]; then
        # bash 3.x only supports integer -t values; use 1 second.
        # Arrow-key bytes are already buffered so this returns instantly.
        IFS= read -r -s -n1 -t 1 _c 2>/dev/null && {
            REPLY="${REPLY}${_c}"
            # CSI (\033[) and SS3 (\033O) are always followed by one more byte
            if [[ $_c == '[' || $_c == 'O' ]]; then
                IFS= read -r -s -n1 -t 1 _c 2>/dev/null && REPLY="${REPLY}${_c}"
            fi
        } || true
    fi
}

# ── Config loading ─────────────────────────────────────────────────────────────
# Reads ~/.config/gitslim/config or ~/.gitslim.
# Supported keys:
#   depth = N          keep N commits (default: 1)
#   since = <spec>     keep history since a date; overrides depth when set
#                      Shorthand: Nd (days), Nw (weeks), Nm (months), Ny (years)
#                      Or any git-understood date: "2024-01-01", "6 months ago"
#   exclude = <glob>   skip this directory during discovery (repeatable);
#                      a bare name ("vendor") matches anywhere, a path
#                      ("~/work/archive", "*/third_party") matches that path
load_config() {
    local cfg=""
    for f in "$HOME/.config/gitslim/config" "$HOME/.gitslim"; do
        [[ -f "$f" ]] && cfg="$f" && break
    done
    [[ -z "$cfg" ]] && return

    while IFS= read -r line; do
        line="${line%%#*}"                                      # strip inline comments
        line="${line#"${line%%[![:space:]]*}"}"                 # ltrim
        line="${line%"${line##*[![:space:]]}"}"                 # rtrim
        [[ -z "$line" || "$line" != *=* ]] && continue
        local key="${line%%=*}" val="${line#*=}"
        key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
        val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
        val="${val#\"}"; val="${val%\"}"                        # strip optional quotes
        val="${val#\'}"; val="${val%\'}"
        case "$key" in
            depth)
                if [[ "$val" =~ ^[1-9][0-9]*$ ]]; then
                    DEPTH="$val"
                else
                    printf "gitslim: config: invalid depth '%s', using default\n" "$val" >&2
                fi ;;
            since) SINCE="$val" ;;
            exclude)
                [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"   # leading ~/ → $HOME
                [[ -n "$val" ]] && EXCLUDES+=("$val") ;;
        esac
    done < "$cfg"
}

# Expand shorthand period specs (30d, 4w, 6m, 1y) to git date strings.
_since_str() {
    local spec="$1"
    if [[ "$spec" =~ ^([0-9]+)([dwmy])$ ]]; then
        local n="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
        case "$unit" in
            d) printf '%d days ago'   "$n" ;;
            w) printf '%d weeks ago'  "$n" ;;
            m) printf '%d months ago' "$n" ;;
            y) printf '%d years ago'  "$n" ;;
        esac
    else
        printf '%s' "$spec"
    fi
}

# ── Slim operation ─────────────────────────────────────────────────────────────
do_slim() {
    local to_slim=()
    for i in "${RI[@]}"; do
        if (( RM[i] && RH[i] )) && [[ "${RW[$i]}" != "true" ]]; then
            to_slim+=("$i")
        fi
    done
    (( ${#to_slim[@]} == 0 )) && return

    tput rmcup; tput cnorm

    printf "\n${BOLD}${CYAN}gitslim${RESET}${INK_MUTE} — slimming ${RESET}${INK}%d repo(s)${RESET}\n" "${#to_slim[@]}"

    for i in "${to_slim[@]}"; do
        local repo="${RP[$i]}"
        printf "\n${BOLD}▸ %s${RESET}\n" "$repo"

        # Bail on dirty working tree
        if ! git -C "$repo" diff --quiet 2>/dev/null || \
           ! git -C "$repo" diff --cached --quiet 2>/dev/null; then
            printf "  ${AMBER}⚠ Skipped${RESET}: uncommitted changes present\n"
            continue
        fi

        # Bail if local commits haven't been pushed (they would be lost)
        local ahead
        ahead=$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null) || ahead=0
        if (( ahead > 0 )); then
            printf "  ${AMBER}⚠ Skipped${RESET}: %d unpushed commit(s) — push first\n" "$ahead"
            continue
        fi

        local size_before="${RS[$i]}" ok=1

        local -a depth_args
        if [[ -n "$SINCE" ]]; then
            depth_args=("--shallow-since=$(_since_str "$SINCE")")
        else
            depth_args=("--depth" "$DEPTH")
        fi

        git -C "$repo" pull "${depth_args[@]}" 2>&1 | sed 's/^/  /' || ok=0

        if (( ok )); then
            git -C "$repo" tag -l 2>/dev/null \
                | xargs git -C "$repo" tag -d -- 2>&1 \
                | sed 's/^/  /' || true
            git -C "$repo" reflog expire --expire=all --all 2>&1 | sed 's/^/  /'
            git -C "$repo" gc --prune=all 2>&1 | sed 's/^/  /'

            local size_after
            size_after=$(du -sk "$repo/.git" 2>/dev/null | cut -f1) || size_after=$size_before
            RS[$i]=$size_after
            RW[$i]="true"
            RM[$i]=0
            local saved=$(( size_before - size_after ))
            (( saved > 0 )) && (( TOTAL_FREED += saved ))
            printf "  ${LIME}✓ Done${RESET} — saved $(fmt_size $saved)\n"
        else
            printf "  ${MAGENTA}✗ Failed${RESET}: git pull returned an error\n"
        fi
    done

    printf "\n${INK_DIM}Press any key to return…${RESET}\n"
    IFS= read -r -s -n1

    tput smcup; tput civis; stty cbreak -echo </dev/tty 2>/dev/null
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1007l'
    do_sort
}

# ── Cache ─────────────────────────────────────────────────────────────────────
# Format: one record per line, tab-separated:
#   <repo_path>\t<git_mtime>\t<size_kb>\t<age_days>\t<has_remote>\t<is_shallow>\t<unpushed>\t<last_mod>
load_cache() {
    [[ ! -f "$CACHE_FILE" ]] && return
    local path mtime kb age hr sh up lm
    while IFS=$'\t' read -r path mtime kb age hr sh up lm; do
        [[ -z "$path" ]] && continue
        CACHE_KEYS+=("$path")
        CACHE_VALS+=("${mtime}"$'\t'"${kb}"$'\t'"${age}"$'\t'"${hr}"$'\t'"${sh}"$'\t'"${up}"$'\t'"${lm}")
    done < "$CACHE_FILE"
}

save_cache() {
    mkdir -p "$(dirname "$CACHE_FILE")" 2>/dev/null || return
    local tmp="${CACHE_FILE}.tmp"
    local i n=${#RP[@]} mtime
    : > "$tmp" || return
    # Keep entries from other search roots: this run only knows its own subtree
    for (( i = 0; i < ${#CACHE_KEYS[@]}; i++ )); do
        _under_root "${CACHE_KEYS[$i]}" && continue
        printf '%s\t%s\n' "${CACHE_KEYS[$i]}" "${CACHE_VALS[$i]}" >> "$tmp"
    done
    for (( i = 0; i < n; i++ )); do
        # Skip unenriched entries (kb still 0)
        (( RS[i] == 0 )) && continue
        mtime=$(stat -f '%m' "${RP[$i]}/.git" 2>/dev/null) || mtime=0
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "${RP[$i]}" "$mtime" "${RS[$i]}" "${RA[$i]}" \
            "${RH[$i]}" "${RW[$i]}" "${RU[$i]}" "${RF[$i]}" >> "$tmp"
    done
    mv "$tmp" "$CACHE_FILE" 2>/dev/null
}

# Look up a repo in the cache. If found AND .git mtime matches, populate the
# data arrays at index $1 and return 0 (cache hit). Otherwise return 1.
cache_lookup() {
    local idx=$1 repo="${RP[$1]}"
    local current_mtime
    current_mtime=$(stat -f '%m' "$repo/.git" 2>/dev/null) || return 1

    local i n=${#CACHE_KEYS[@]}
    for (( i = 0; i < n; i++ )); do
        [[ "${CACHE_KEYS[$i]}" != "$repo" ]] && continue
        local mtime kb age hr sh up lm
        IFS=$'\t' read -r mtime kb age hr sh up lm <<< "${CACHE_VALS[$i]}"
        [[ "$mtime" != "$current_mtime" ]] && return 1
        RS[$idx]="$kb"; RA[$idx]="$age"; RH[$idx]="$hr"
        RW[$idx]="$sh"; RU[$idx]="$up"; RF[$idx]="$lm"
        return 0
    done
    return 1
}

# ── Scan phase 1: discover repos (cheap; just `find`) ─────────────────────────
# `find` over a large tree (e.g. all of $HOME) can take a minute, so show the
# splash with a live count instead of a blank screen. Returns 1 if the user quit.
draw_splash() {
    tput cup 0 0
    printf '%s' "$CYAN"
    cat << 'LOGO'
       _ _       _ _
   ___(_) |_ ___| (_)_ __ ___
  / _ \ | __/ __| | | '_ ` _ \
 | (_| | | |_\__ \ | | | | | |
  \__, |_|\__|___/_|_|_| |_| |
   __/ |
  |___/  ✂─ ─ ─ ─ ─ ─ ─
LOGO
    printf '%s\n' "$RESET"
}

draw_discover_status() {
    local tilde='~'   # literal; bash 4.3+ tilde-expands a bare ~ in the replacement
    local rw=$(( $(_cols) - 40 ))   # room left for the path after the fixed text
    (( rw < 12 )) && rw=12
    tput cup 9 0
    printf '  %sSearching%s %s%s%s %s…%s ' \
        "$INK_DIM" "$RESET" "$INK" "$(fit "${SEARCH_ROOT/#$HOME/$tilde}" "$rw")" \
        "$RESET" "$INK_DIM" "$RESET"
    printf '%s%d%s %srepos found%s' "$CYAN" "${#RP[@]}" "$RESET" "$INK_DIM" "$RESET"
    tput el
    printf '\n\n  %sQ or Ctrl-C to quit%s' "$INK_MUTE" "$RESET"
    tput el
}

# With repos already seeded from the cache (SEARCHING=1) the list stays on
# screen and new finds are appended to it; otherwise the splash is shown.
# Afterwards, repos no longer found (deleted, or now excluded) are dropped.
_discover_redraw() {
    if (( SEARCHING )); then
        draw
    else
        draw_discover_status
    fi
}

discover_repos() {
    local seeded=${#RP[@]} known=$'\n' i
    for (( i = 0; i < seeded; i++ )); do known+="${RP[$i]}"$'\n'; done
    local found=$'\n'   # every repo find reports, for dropping stale seeds

    tput clear
    if (( SEARCHING )); then
        draw
    else
        draw_splash
        draw_discover_status
    fi

    # find runs in the background, writing to a temp file that is polled on a
    # timer. Reading its output directly would leave the UI frozen (and Q
    # unread) through long stretches with no matches, and bash 3.2's `read -t`
    # discards partial lines on timeout so it can't be used to break that up.
    local prune=() pat
    for pat in "${EXCLUDES[@]}"; do
        # Asking for an excluded dir by name (`gitslim ~/Library`) overrides it
        # shellcheck disable=SC2053  # glob match intended
        [[ "$SEARCH_ROOT" == $pat || "${SEARCH_ROOT##*/}" == $pat ]] && continue
        (( ${#prune[@]} )) && prune+=(-o)
        [[ "$pat" == */* ]] && prune+=(-path "$pat") || prune+=(-name "$pat")
    done

    DISCOVER_TMP=$(mktemp)
    find "$SEARCH_ROOT" \( "${prune[@]}" \) -prune \
        -o -type d -name '.git' -print >"$DISCOVER_TMP" 2>/dev/null &
    local fpid=$! seen=0 total finished=0 git_dir
    REPLY=""

    while true; do
        kill -0 "$fpid" 2>/dev/null || finished=1   # check before reading: no lines missed
        total=$(wc -l <"$DISCOVER_TMP"); total=${total//[!0-9]/}
        if (( total > seen )); then
            # Only complete (newline-terminated) lines; a partial last line waits
            while IFS= read -r git_dir; do
                [[ ! -d "$git_dir" ]] && continue          # skip submodule .git files
                local repo="${git_dir%/.git}"
                [[ ! -d "$repo"    ]] && continue

                found+="$repo"$'\n'
                [[ "$known" == *$'\n'"$repo"$'\n'* ]] && continue   # seeded from cache
                RP+=("$repo")
                RS+=(0); RA+=(9999); RH+=(0); RW+=("false"); RU+=(0); RF+=(0); RM+=(0)
                RI+=("$(( ${#RP[@]} - 1 ))")
            done < <(sed -n "$(( seen + 1 )),${total}p" "$DISCOVER_TMP")
            seen=$total
            _discover_redraw
        fi
        if (( RESIZED )); then
            RESIZED=0; tput clear
            (( SEARCHING )) || draw_splash
            _discover_redraw
        fi
        (( finished )) && break

        poll_key
        case "$REPLY" in q|Q) kill "$fpid" 2>/dev/null; break ;; esac
        sleep 0.2
    done

    wait "$fpid" 2>/dev/null
    rm -f "$DISCOVER_TMP"; DISCOVER_TMP=""
    case "$REPLY" in q|Q) return 1 ;; esac

    (( seeded )) && drop_unfound "$found"
    return 0
}

# Remove repos (from the cache seed) that the finished `find` didn't report.
# Arg: newline-delimited, newline-wrapped list of found repo paths.
drop_unfound() {
    local found=$1 i n=${#RP[@]}
    local -a p=() s=() a=() h=() w=() u=() f=() m=()
    for (( i = 0; i < n; i++ )); do
        [[ "$found" == *$'\n'"${RP[$i]}"$'\n'* ]] || continue
        p+=("${RP[$i]}"); s+=("${RS[$i]}"); a+=("${RA[$i]}"); h+=("${RH[$i]}")
        w+=("${RW[$i]}"); u+=("${RU[$i]}"); f+=("${RF[$i]}"); m+=("${RM[$i]}")
    done
    (( ${#p[@]} == n )) && return
    _log "dropping $(( n - ${#p[@]} )) cached repos not found on disk"
    RP=(); RS=(); RA=(); RH=(); RW=(); RU=(); RF=(); RM=(); RI=()
    (( ${#p[@]} )) || return   # "${p[@]}" on an empty array trips set -u in bash 3.2
    RP=("${p[@]}"); RS=("${s[@]}"); RA=("${a[@]}"); RH=("${h[@]}")
    RW=("${w[@]}"); RU=("${u[@]}"); RF=("${f[@]}"); RM=("${m[@]}")
    for (( i = 0; i < ${#RP[@]}; i++ )); do RI+=("$i"); done
    CURSOR=0; SCROLL=0
}

# The root is quoted so any glob characters in it ([, ?, *) match literally
_under_root() { [[ "$1" == "$SEARCH_ROOT" || "$1" == "${SEARCH_ROOT%/}/"* ]]; }

# Seed the list from cached repos under SEARCH_ROOT whose .git still exists,
# so a repeat run shows its list at once while `find` looks for new repos.
seed_from_cache() {
    local i n=${#CACHE_KEYS[@]} path
    for (( i = 0; i < n; i++ )); do
        path="${CACHE_KEYS[$i]}"
        _under_root "$path" || continue
        [[ -d "$path/.git" ]] || continue
        RP+=("$path")
        RS+=(0); RA+=(9999); RH+=(0); RW+=("false"); RU+=(0); RF+=(0); RM+=(0)
        RI+=("$(( ${#RP[@]} - 1 ))")
        cache_lookup "$(( ${#RP[@]} - 1 ))" || true   # fills fresh entries now
    done
}

# ── Scan phase 2: enrich one repo with sizes/ages/remote/etc ──────────────────
enrich_repo() {
    local i=$1 now=$2
    local repo="${RP[$i]}"

    # Cache hit: skip the expensive work
    cache_lookup "$i" && return

    local kb
    kb=$(du -sk "$repo/.git" 2>/dev/null | cut -f1) || kb=0
    [[ -z "$kb" ]] && kb=0
    RS[$i]="$kb"

    local ts; ts=$(git -C "$repo" log -1 --format="%at" 2>/dev/null || true)
    [[ "$ts" =~ ^[0-9]+$ ]] && RA[$i]=$(( (now - ts) / 86400 ))

    RW[$i]=$(git -C "$repo" rev-parse --is-shallow-repository 2>/dev/null || echo "false")

    local nremotes
    nremotes=$(git -C "$repo" remote 2>/dev/null | wc -l | tr -d '[:space:]')
    (( nremotes > 0 )) && RH[$i]=1

    local ahead
    ahead=$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null) \
        && (( ahead > 0 )) && RU[$i]=1 || true

    # Tracked + untracked-but-not-ignored files only. A plain `find` also walked
    # .git, node_modules, build output, etc. — slow, and an `npm install`
    # isn't a "touch". Deleted-but-tracked files make stat fail; that's fine.
    local fmod
    fmod=$(git -C "$repo" ls-files -z -co --exclude-standard 2>/dev/null \
               | (cd "$repo" && xargs -0 stat -f '%m' 2>/dev/null) | sort -rn | head -1)
    [[ "$fmod" =~ ^[0-9]+$ ]] && RF[$i]="$fmod"
}

scan() {
    local now; now=$(date +%s)
    load_cache
    seed_from_cache
    (( ${#RP[@]} )) && { SEARCHING=1; do_sort; }   # cached list: show it sorted

    discover_repos || return 1
    SEARCHING=0
    tput clear
    draw   # show full list with placeholder data immediately

    local i n=${#RP[@]}
    for (( i = 0; i < n; i++ )); do
        enrich_repo "$i" "$now"
        (( RESIZED )) && { RESIZED=0; tput clear; }
        draw

        poll_key
        case "$REPLY" in q|Q) return 1 ;; esac
    done

    save_cache
}

# ── Main ───────────────────────────────────────────────────────────────────────
main() {
    load_config
    _log "startup: bash=$BASH_VERSION TERM=${TERM:-unset}"

    # Enter TUI before scanning so the splash and repos appear as they're found
    SAVED_STTY=$(stty -g </dev/tty 2>/dev/null)
    tput smcup
    tput civis
    tput rmam 2>/dev/null || true
    # cbreak: per-char delivery; min 0 time 0: reads return immediately (poll_key)
    stty cbreak -echo min 0 time 0 </dev/tty 2>/dev/null
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1007l'  # disable all mouse

    SCANNING=1
    scan || { _cleanup; exit 0; }   # return 1 means user quit during scan
    SCANNING=0

    if (( ${#RP[@]} == 0 )); then
        _cleanup
        printf "No git repositories found under %s\n" "$SEARCH_ROOT"
        exit 0
    fi

    do_sort   # apply chosen sort order now that all repos are known

    # Discard any keys pressed during scan to avoid spurious navigation, then
    # switch back to blocking reads for the interactive loop
    poll_key; while [[ -n "$REPLY" ]]; do poll_key; done
    stty min 1 time 0 </dev/tty 2>/dev/null

    while true; do
        (( RESIZED )) && { RESIZED=0; tput clear; }
        draw
        read_key
        local n=${#RI[@]}
        case "$REPLY" in
            $'\033[A'|$'\033OA'|k|K)  # up
                (( CURSOR > 0     )) && (( CURSOR-- )) ;;
            $'\033[B'|$'\033OB'|j|J)  # down
                (( CURSOR < n - 1 )) && (( CURSOR++ )) ;;
            ' ')            # toggle mark
                local i="${RI[$CURSOR]}"
                RM[$i]=$(( 1 - RM[i] )) ;;
            s|S)  _log "slimming marked repos"; do_slim ;;
            r|R)  SORT_BY=age;  CURSOR=0; SCROLL=0; do_sort ;;
            z|Z)  SORT_BY=size; CURSOR=0; SCROLL=0; do_sort ;;
            p|P)  SORT_BY=path; CURSOR=0; SCROLL=0; do_sort ;;
            q|Q|$'\x03')  break ;;
        esac
    done
}

main
