#!/usr/bin/env bash
# gitslim — interactively find and slim git repositories to shallow clones
#
# Requires: bash 3.0+, git, find, du, tput, sort
# Usage: gitslim [search-root]   (default: $HOME)
#
# Keys: ↑/↓ or j/k navigate · SPACE mark · S slim marked · R age · Z size · P path · Q quit

set -uo pipefail

if (( BASH_VERSINFO[0] < 3 )); then
    printf 'gitslim: requires bash 3.0 or newer (running %s)\n' "$BASH_VERSION" >&2
    exit 1
fi

SEARCH_ROOT="${1:-$HOME}"

# ── Debug log ──────────────────────────────────────────────────────────────────
# Set to a path (e.g. /tmp/gitslim-debug.log) to enable; empty to disable.
DEBUG_LOG=""
_log() {
    [[ -z "$DEBUG_LOG" ]] && return
    printf '%s %s\n' "$(date '+%T')" "$*" >> "$DEBUG_LOG"
}
[[ -n "$DEBUG_LOG" ]] && : > "$DEBUG_LOG"

# ── ANSI ───────────────────────────────────────────────────────────────────────
ESC=$'\033'
BOLD="${ESC}[1m" DIM="${ESC}[2m" RESET="${ESC}[0m" REVERSE="${ESC}[7m"
RED="${ESC}[31m" GREEN="${ESC}[32m" YELLOW="${ESC}[33m" CYAN="${ESC}[36m"

_rows() { local s; s=$(stty size 2>/dev/null) && printf '%s' "${s% *}" || tput lines 2>/dev/null || printf '24'; }
_cols() { local s; s=$(stty size 2>/dev/null) && printf '%s' "${s#* }" || tput cols  2>/dev/null || printf '80'; }
_sep()  { printf '─%.0s' $(seq 1 "${1:-$(_cols)}"); printf '\n'; }

# ── Data arrays ────────────────────────────────────────────────────────────────
declare -a RP=()   # repo path
declare -a RS=()   # .git size in KB
declare -a RA=()   # age in days since last commit
declare -a RH=()   # has remote: 1/0
declare -a RW=()   # is shallow: true/false
declare -a RU=()   # has unpushed commits: 1/0
declare -a RM=()   # marked: 1/0
declare -a RI=()   # sorted indices into above arrays

CURSOR=0; SCROLL=0; SORT_BY=age

# Config (overridden by load_config)
DEPTH=1    # commits to keep (--depth N)
SINCE=""   # keep history since date/period (overrides DEPTH when set)

# ── Cleanup ────────────────────────────────────────────────────────────────────
_cleanup() {
    tput smam  2>/dev/null || true   # re-enable line wrap
    tput rmcup 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    stty echo  2>/dev/null || true
}
trap _cleanup EXIT
trap '_log "received SIGINT";  exit 130' INT
trap '_log "received SIGTERM"; exit 143' TERM

# ── Formatting ─────────────────────────────────────────────────────────────────
fmt_size() {
    local kb=$1
    if   (( kb < 1024    )); then printf '%5d KB' "$kb"
    elif (( kb < 1048576 )); then printf '%5d MB' "$((kb / 1024))"
    else                          printf '%5d GB' "$((kb / 1048576))"
    fi
}

fmt_age() {
    local d=$1
    if   (( d == 0  )); then printf 'today'
    elif (( d == 1  )); then printf '1 day ago'
    elif (( d <  7  )); then printf '%d days ago'   "$d"
    elif (( d <  14 )); then printf '1 week ago'
    elif (( d <  30 )); then printf '%d weeks ago'  "$((d / 7))"
    elif (( d <  60 )); then printf '1 month ago'
    elif (( d < 365 )); then printf '%d months ago' "$((d / 30))"
    elif (( d < 730 )); then printf '1 year ago'
    else                     printf '%d years ago'  "$((d / 365))"
    fi
}

# Truncate/pad string to exact width (handles ~ paths)
fit() {
    local s="$1" w=$2
    if (( ${#s} > w )); then printf '%s…' "${s:0:$((w - 1))}"
    else printf '%-*s' "$w" "$s"
    fi
}

# ── Sorting ────────────────────────────────────────────────────────────────────
do_sort() {
    local n=${#RP[@]}; RI=()
    (( n == 0 )) && return

    local tmp; tmp=$(mktemp)
    # age/size: descending (oldest/largest first); path: ascending
    for (( i = 0; i < n; i++ )); do
        case "$SORT_BY" in
            age)  printf '%010d\t%d\n' "${RA[$i]}" "$i" ;;
            size) printf '%015d\t%d\n' "${RS[$i]}" "$i" ;;
            path) printf '%s\t%d\n'   "${RP[$i]}" "$i" ;;
        esac
    done | if [[ "$SORT_BY" == path ]]; then sort -t$'\t' -k1
           else sort -t$'\t' -k1 -r
           fi > "$tmp"

    RI=()
    while IFS=$'\t' read -r _ idx; do RI+=("$idx"); done < "$tmp"
    rm -f "$tmp"

    local max=$(( ${#RI[@]} - 1 ))
    (( CURSOR > max )) && CURSOR=$max
    (( CURSOR < 0   )) && CURSOR=0
}

# ── TUI drawing ────────────────────────────────────────────────────────────────
HEADER_H=4   # title + sep + col-headers + sep
# FOOTER_H is computed dynamically in draw() (2 baseline + 1 if legend needed)

draw() {
    local cols rows
    cols=$(_cols); rows=$(_rows)

    local n=${#RI[@]} mc=0 ms=0 has_noremote=0 has_shallow=0 has_unpushed=0
    for i in "${RI[@]}"; do
        (( RM[i]          )) && { (( mc++ )); (( ms += RS[i] )); }
        (( RH[i] == 0     )) && has_noremote=1
        [[ "${RW[$i]}" == "true" ]] && has_shallow=1
        (( RU[i]          )) && has_unpushed=1
    done

    # Footer is 2 lines (sep + keys) plus 1 if any legend symbols are in use
    local footer_h=2
    (( has_noremote || has_shallow || has_unpushed )) && (( footer_h++ ))

    local vrows=$(( rows - HEADER_H - footer_h ))
    (( vrows < 1 )) && vrows=1

    # Clamp scroll so cursor stays visible
    (( CURSOR < SCROLL          )) && SCROLL=$CURSOR
    (( CURSOR >= SCROLL + vrows )) && SCROLL=$(( CURSOR - vrows + 1 ))
    (( SCROLL < 0               )) && SCROLL=0

    # Row layout: " [M] <path>  <size>  <age>  <status> "
    # Fixed visible chars outside path: 1+3+1 + 2+8 + 2+15 + 2+1+1 = 36
    local pw=$(( cols - 36 ))
    (( pw < 12 )) && pw=12

    tput cup 0 0

    # ── Header ──
    local marked_str=""
    (( mc > 0 )) && marked_str="  ·  ${mc} marked ($(fmt_size $ms))"
    printf "${BOLD}${CYAN}gitslim${RESET}  ·  %d repos  ·  sort:%s%s" "$n" "$SORT_BY" "$marked_str"
    tput el 2>/dev/null; printf '\n'
    _sep "$cols"

    # ── Column headers ──
    printf "${DIM}     %-*s  %8s  %-15s${RESET}" "$pw" "PATH" "GIT SIZE" "LAST COMMIT"
    tput el 2>/dev/null; printf '\n'
    _sep "$cols"

    # ── Repo rows ──
    local end=$(( SCROLL + vrows ))
    (( end > n )) && end=$n
    local row=0

    for (( vi = SCROLL; vi < end; vi++ )); do
        local i="${RI[$vi]}"
        local path="${RP[$i]/#$HOME/\~}"
        local mark="[ ]"; (( RM[i] )) && mark="[${GREEN}*${RESET}]"
        local status=" "
        (( RH[i] == 0         )) && status="⚠"
        [[ "${RW[$i]}" == "true" ]] && status="✓"
        (( RU[i]              )) && status="!"

        (( vi == CURSOR )) && printf '%s' "$REVERSE"
        printf " %s $(fit "$path" "$pw")  %s  %-15s  %s " \
            "$mark" \
            "$(fmt_size "${RS[$i]}")" \
            "$(fmt_age "${RA[$i]}")" \
            "$status"
        tput el 2>/dev/null   # erase to EOL; also extends reverse highlight on cursor row
        (( vi == CURSOR )) && printf '%s' "$RESET"
        printf '\n'
        (( row++ ))
    done

    # Fill blank rows so stale content doesn't show
    for (( ; row < vrows; row++ )); do
        tput el 2>/dev/null; printf '\n'
    done

    # ── Footer ──
    _sep "$cols"
    printf " ${DIM}↑↓/jk${RESET} move  ${DIM}SPC${RESET} mark  ${DIM}S${RESET} slim  ${DIM}R${RESET} age  ${DIM}Z${RESET} size  ${DIM}P${RESET} path  ${DIM}Q${RESET} quit"
    tput el 2>/dev/null
    if (( footer_h == 3 )); then
        printf '\n'
        local legend=""
        (( has_shallow  )) && legend+=" ${DIM}✓ shallow${RESET}"
        (( has_noremote )) && legend+=" ${DIM}⚠ no remote${RESET}"
        (( has_unpushed )) && legend+=" ${DIM}! unpushed commits${RESET}"
        printf "%s" "$legend"
        tput el 2>/dev/null
    fi
    # No trailing newline — printing past the last row scrolls the terminal
}

# ── Key input ──────────────────────────────────────────────────────────────────
read_key() {
    local _c
    IFS= read -r -s -n1 REPLY
    if [[ $REPLY == $'\033' ]]; then
        # bash 3.x only supports integer -t values; use 1 second.
        # Arrow-key bytes are already buffered so this returns instantly.
        IFS= read -r -s -n1 -t 1 _c 2>/dev/null && {
            REPLY="${REPLY}${_c}"
            # CSI (\033[) and SS3 (\033O) are always followed by one more byte
            if [[ $_c == '[' || $_c == 'O' ]]; then
                IFS= read -r -s -n1 -t 1 _c 2>/dev/null && REPLY="${REPLY}${_c}"
            fi
        } || true
    fi
}

# ── Config loading ─────────────────────────────────────────────────────────────
# Reads ~/.config/gitslim/config or ~/.gitslim.
# Supported keys:
#   depth = N          keep N commits (default: 1)
#   since = <spec>     keep history since a date; overrides depth when set
#                      Shorthand: Nd (days), Nw (weeks), Nm (months), Ny (years)
#                      Or any git-understood date: "2024-01-01", "6 months ago"
load_config() {
    local cfg=""
    for f in "$HOME/.config/gitslim/config" "$HOME/.gitslim"; do
        [[ -f "$f" ]] && cfg="$f" && break
    done
    [[ -z "$cfg" ]] && return

    while IFS= read -r line; do
        line="${line%%#*}"                                      # strip inline comments
        line="${line#"${line%%[![:space:]]*}"}"                 # ltrim
        line="${line%"${line##*[![:space:]]}"}"                 # rtrim
        [[ -z "$line" || "$line" != *=* ]] && continue
        local key="${line%%=*}" val="${line#*=}"
        key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
        val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
        val="${val#\"}"; val="${val%\"}"                        # strip optional quotes
        val="${val#\'}"; val="${val%\'}"
        case "$key" in
            depth)
                if [[ "$val" =~ ^[1-9][0-9]*$ ]]; then
                    DEPTH="$val"
                else
                    printf "gitslim: config: invalid depth '%s', using default\n" "$val" >&2
                fi ;;
            since) SINCE="$val" ;;
        esac
    done < "$cfg"
}

# Expand shorthand period specs (30d, 4w, 6m, 1y) to git date strings.
_since_str() {
    local spec="$1"
    if [[ "$spec" =~ ^([0-9]+)([dwmy])$ ]]; then
        local n="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
        case "$unit" in
            d) printf '%d days ago'   "$n" ;;
            w) printf '%d weeks ago'  "$n" ;;
            m) printf '%d months ago' "$n" ;;
            y) printf '%d years ago'  "$n" ;;
        esac
    else
        printf '%s' "$spec"
    fi
}

# ── Slim operation ─────────────────────────────────────────────────────────────
do_slim() {
    local to_slim=()
    for i in "${RI[@]}"; do
        if (( RM[i] && RH[i] )) && [[ "${RW[$i]}" != "true" ]]; then
            to_slim+=("$i")
        fi
    done
    (( ${#to_slim[@]} == 0 )) && return

    tput rmcup; tput cnorm

    printf "\n${BOLD}${CYAN}gitslim — slimming %d repo(s)${RESET}\n" "${#to_slim[@]}"

    for i in "${to_slim[@]}"; do
        local repo="${RP[$i]}"
        printf "\n${BOLD}▸ %s${RESET}\n" "$repo"

        # Bail on dirty working tree
        if ! git -C "$repo" diff --quiet 2>/dev/null || \
           ! git -C "$repo" diff --cached --quiet 2>/dev/null; then
            printf "  ${YELLOW}⚠ Skipped${RESET}: uncommitted changes present\n"
            continue
        fi

        # Bail if local commits haven't been pushed (they would be lost)
        local ahead
        ahead=$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null) || ahead=0
        if (( ahead > 0 )); then
            printf "  ${YELLOW}⚠ Skipped${RESET}: %d unpushed commit(s) — push first\n" "$ahead"
            continue
        fi

        local size_before="${RS[$i]}" ok=1

        local -a depth_args
        if [[ -n "$SINCE" ]]; then
            depth_args=("--shallow-since=$(_since_str "$SINCE")")
        else
            depth_args=("--depth" "$DEPTH")
        fi

        git -C "$repo" pull "${depth_args[@]}" 2>&1 | sed 's/^/  /' || ok=0

        if (( ok )); then
            local tags; tags=$(git -C "$repo" tag -l 2>/dev/null || true)
            if [[ -n "$tags" ]]; then
                # shellcheck disable=SC2086
                git -C "$repo" tag -d $tags 2>&1 | sed 's/^/  /' || true
            fi
            git -C "$repo" reflog expire --expire=all --all 2>&1 | sed 's/^/  /'
            git -C "$repo" gc --prune=all 2>&1 | sed 's/^/  /'

            local size_after
            size_after=$(du -sk "$repo/.git" 2>/dev/null | cut -f1) || size_after=$size_before
            RS[$i]=$size_after
            RW[$i]="true"
            RM[$i]=0
            local saved=$(( size_before - size_after ))
            printf "  ${GREEN}✓ Done${RESET} — saved $(fmt_size $saved)\n"
        else
            printf "  ${RED}✗ Failed${RESET}: git pull --depth 1 returned an error\n"
        fi
    done

    printf "\n${DIM}Press any key to return...${RESET}\n"
    IFS= read -r -s -n1

    tput smcup; tput civis; stty -echo
    do_sort
}

# ── Scan phase ─────────────────────────────────────────────────────────────────
scan() {
    local now; now=$(date +%s)

    while IFS= read -r git_dir; do
        [[ ! -d "$git_dir" ]] && continue          # skip submodule .git files
        local repo="${git_dir%/.git}"
        [[ ! -d "$repo"    ]] && continue

        local kb
        kb=$(du -sk "$git_dir" 2>/dev/null | cut -f1) || continue
        [[ -z "$kb" ]] && continue

        local ts; ts=$(git -C "$repo" log -1 --format="%at" 2>/dev/null || true)
        local age=9999
        [[ "$ts" =~ ^[0-9]+$ ]] && age=$(( (now - ts) / 86400 ))

        local shallow
        shallow=$(git -C "$repo" rev-parse --is-shallow-repository 2>/dev/null || echo "false")

        local nremotes
        nremotes=$(git -C "$repo" remote 2>/dev/null | wc -l | tr -d '[:space:]')
        local has_remote=0; (( nremotes > 0 )) && has_remote=1

        local unpushed=0
        local ahead
        ahead=$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null) \
            && (( ahead > 0 )) && unpushed=1 || true

        RP+=("$repo"); RS+=("$kb"); RA+=("$age")
        RH+=("$has_remote"); RW+=("$shallow"); RU+=("$unpushed"); RM+=(0)

        printf "\r  Scanning… found %d repositories" "${#RP[@]}" >&2

    done < <(
        find "$SEARCH_ROOT" \
            \( -path '*/node_modules' \
               -o -path '*/.Trash' \
               -o -path '*/Library/Caches' \
               -o -path '*/Library/Developer' \
            \) -prune \
            -o -type d -name '.git' -print 2>/dev/null
    )

    printf "\r  Found %d repositories.%20s\n" "${#RP[@]}" '' >&2
}

# ── Main ───────────────────────────────────────────────────────────────────────
main() {
    load_config
    _log "startup: bash=$BASH_VERSION TERM=${TERM:-unset}"
    printf "${BOLD}${CYAN}gitslim${RESET}  —  scanning %s\n" "$SEARCH_ROOT"
    scan
    do_sort

    if (( ${#RI[@]} == 0 )); then
        printf "No git repositories found under %s\n" "$SEARCH_ROOT"
        exit 0
    fi

    tput smcup
    tput civis
    tput rmam 2>/dev/null || true   # disable line wrap; overflow clips instead
    stty -echo

    while true; do
        draw
        read_key
        local n=${#RI[@]}
        case "$REPLY" in
            $'\033[A'|$'\033OA'|k|K)  # up
                (( CURSOR > 0     )) && (( CURSOR-- )) ;;
            $'\033[B'|$'\033OB'|j|J)  # down
                (( CURSOR < n - 1 )) && (( CURSOR++ )) ;;
            ' ')            # toggle mark
                local i="${RI[$CURSOR]}"
                RM[$i]=$(( 1 - RM[i] )) ;;
            s|S)  _log "slimming marked repos"; do_slim ;;
            r|R)  SORT_BY=age;  CURSOR=0; SCROLL=0; do_sort ;;
            z|Z)  SORT_BY=size; CURSOR=0; SCROLL=0; do_sort ;;
            p|P)  SORT_BY=path; CURSOR=0; SCROLL=0; do_sort ;;
            q|Q|$'\x03')  break ;;
        esac
    done
}

main
